<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Mystic Oracle — Айгуль Галинская</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">

<style>

:root{
--bg:#05060b;
--card:#0d1018;
--gold:#f3d7a1;
--pink:#ff61ad;
--text:#f7f2ea;
--muted:#b7b4c7;
}

*{
margin:0;
padding:0;
box-sizing:border-box;
}

html{
scroll-behavior:smooth;
}

body{
font-family:'Montserrat',sans-serif;
background:
linear-gradient(rgba(3,4,10,.9),rgba(3,4,10,.95)),
url('photo.jpg');
background-size:cover;
background-position:center 15%;
background-attachment:fixed;
color:var(--text);
overflow-x:hidden;
min-height:100vh;
}

body::before{
content:'';
position:fixed;
inset:0;
background:
radial-gradient(circle at top, rgba(255,97,173,.15), transparent 30%),
radial-gradient(circle at bottom, rgba(243,215,161,.08), transparent 35%);
pointer-events:none;
z-index:0;
}

.stars{
position:fixed;
inset:0;
overflow:hidden;
z-index:0;
}

.star{
position:absolute;
width:2px;
height:2px;
background:white;
border-radius:50%;
opacity:.3;
animation:twinkle 5s infinite ease-in-out;
}

@keyframes twinkle{
0%,100%{
opacity:.2;
transform:scale(1);
}
50%{
opacity:1;
transform:scale(1.7);
}
}

.container{
position:relative;
z-index:2;
max-width:1200px;
margin:auto;
padding:24px 16px 100px;
}

.hero{
text-align:center;
padding-top:50px;
animation:fadeUp 1s ease;
}

@keyframes fadeUp{
from{
opacity:0;
transform:translateY(30px);
}
to{
opacity:1;
transform:translateY(0);
}
}

.logo{
font-family:'Cormorant Garamond',serif;
font-size:72px;
font-weight:700;
line-height:1;
margin-bottom:24px;
background:linear-gradient(to right,#ffd7ee,#f3d7a1);
-webkit-background-clip:text;
-webkit-text-fill-color:transparent;
}

.hero-card{
max-width:980px;
margin:auto;
padding:42px 34px;
background:rgba(8,10,18,.72);
border:1px solid rgba(255,255,255,.08);
border-radius:34px;
backdrop-filter:blur(18px);
box-shadow:0 25px 60px rgba(0,0,0,.5);
}

.hero-name{
font-family:'Cormorant Garamond',serif;
font-size:58px;
margin-bottom:18px;
color:#fff3dd;
}

.hero-card p{
line-height:2;
font-size:15px;
margin-bottom:18px;
color:#f2eef8;
}

.menu{
display:flex;
justify-content:center;
gap:14px;
flex-wrap:wrap;
margin:34px 0 10px;
}

.menu button{
border:none;
cursor:pointer;
padding:16px 24px;
border-radius:18px;
background:rgba(255,255,255,.05);
border:1px solid rgba(255,255,255,.08);
color:white;
font-weight:600;
transition:.35s;
backdrop-filter:blur(10px);
}

.menu button:hover,
.menu button.active{
background:linear-gradient(to right,#ff61ad,#ffd194);
color:#111;
transform:translateY(-3px);
}

.panel{
display:none;
animation:fadeUp .7s ease;
margin-top:30px;
}

.panel.active{
display:block;
}

.center{
text-align:center;
}

textarea{
width:100%;
max-width:760px;
min-height:120px;
background:rgba(255,255,255,.05);
border:1px solid rgba(255,255,255,.08);
border-radius:24px;
padding:20px;
color:white;
font-size:15px;
outline:none;
resize:none;
backdrop-filter:blur(12px);
}

.main-btn{
border:none;
cursor:pointer;
padding:18px 34px;
border-radius:20px;
background:linear-gradient(to right,#ff61ad,#ffd194);
color:#111;
font-weight:700;
font-size:15px;
transition:.35s;
box-shadow:0 10px 30px rgba(255,97,173,.22);
}

.main-btn:hover{
transform:translateY(-4px);
}

.cards{
display:flex;
justify-content:center;
gap:24px;
flex-wrap:wrap;
margin-top:44px;
}

.tarot-card{
width:220px;
height:390px;
perspective:1400px;
cursor:pointer;
animation:cardAppear .8s ease forwards;
opacity:0;
transform:translateY(30px);
}

.tarot-card:nth-child(2){
animation-delay:.2s;
}

.tarot-card:nth-child(3){
animation-delay:.4s;
}

@keyframes cardAppear{
to{
opacity:1;
transform:translateY(0);
}
}

.card-inner{
position:relative;
width:100%;
height:100%;
transform-style:preserve-3d;
transition:1s;
}

.tarot-card.flipped .card-inner{
transform:rotateY(180deg);
}

.card-front,
.card-back{
position:absolute;
inset:0;
border-radius:28px;
overflow:hidden;
backface-visibility:hidden;
}

.card-front{
background:
linear-gradient(rgba(0,0,0,.2),rgba(0,0,0,.5)),
url('back.jpg');
background-size:cover;
background-position:center;
border:1px solid rgba(255,255,255,.08);
box-shadow:
0 0 35px rgba(255,97,173,.18),
0 18px 45px rgba(0,0,0,.55);
display:flex;
align-items:center;
justify-content:center;
}

.card-front span{
background:rgba(0,0,0,.45);
padding:12px 18px;
border-radius:14px;
font-size:14px;
}

.card-back{
transform:rotateY(180deg);
background:
linear-gradient(
180deg,
rgba(13,16,25,.98),
rgba(7,10,16,.98)
);
border:1px solid rgba(255,255,255,.08);
padding:16px;
overflow-y:auto;
}

.card-back img{
width:100%;
border-radius:18px;
margin-bottom:16px;
}

.card-back h3{
font-family:'Cormorant Garamond',serif;
font-size:38px;
line-height:1;
margin-bottom:14px;
color:#ffe7bc;
text-align:center;
}

.card-back p{
font-size:14px;
line-height:1.9;
color:#f2eef8;
text-align:left;
}

.result{
display:none;
max-width:980px;
margin:50px auto 0;
padding:38px 30px;
background:rgba(8,10,18,.78);
border:1px solid rgba(255,255,255,.08);
border-radius:32px;
backdrop-filter:blur(18px);
animation:fadeUp 1s ease;
}

.result h2{
font-family:'Cormorant Garamond',serif;
font-size:54px;
margin-bottom:22px;
color:#fff0d0;
text-align:center;
}

.result p{
line-height:2;
margin-bottom:16px;
color:#f2eef8;
text-align:left;
}

.week-date{
text-align:center;
margin-bottom:20px;
font-size:18px;
color:#f4d7ff;
}

.buttons{
display:flex;
justify-content:center;
gap:14px;
flex-wrap:wrap;
margin-top:32px;
}

.buttons a,
.buttons button{
border:none;
cursor:pointer;
text-decoration:none;
padding:16px 22px;
border-radius:18px;
font-weight:700;
font-size:14px;
transition:.35s;
}

.btn-main{
background:linear-gradient(to right,#ff61ad,#ffd194);
color:#111;
}

.btn-dark{
background:rgba(255,255,255,.05);
border:1px solid rgba(255,255,255,.08);
color:white;
}

.footer{
text-align:center;
margin-top:70px;
line-height:1.8;
font-size:13px;
color:#aaa5b7;
}

@media(max-width:768px){

.logo{
font-size:52px;
}

.hero-name{
font-size:42px;
}

.hero-card{
padding:30px 22px;
}

.tarot-card{
width:170px;
height:310px;
}

.card-back h3{
font-size:30px;
}

.result{
padding:28px 22px;
}

.result h2{
font-size:40px;
}

}

</style>
</head>

<body>

<div class="stars" id="stars"></div>

<div class="container">

<section class="hero">

<div class="logo">
Mystic Oracle
</div>

<div class="hero-card">

<div class="hero-name">
Айгуль Галинская
</div>

<p>
Практик, проводник и специалист по глубокой трансформации состояния человека.
</p>

<p>
В своей работе я соединяю психологию, нейрокоучинг, Матрицу Судьбы, Таро, руны, энергопрактики, немного магии и отливки воском.
</p>

<p>
Мне близок бережный и глубокий подход, где эзотерика помогает не уйти от реальности, а глубже понять причины происходящего, восстановить внутреннее состояние и вернуть человеку внутреннюю опору.
</p>

<p>
Этот оракул — пространство, где ты можешь услышать себя глубже ✨
</p>

</div>

<div class="menu">

<button class="active" onclick="showPanel('day',this)">
☾ Карта дня
</button>

<button onclick="showPanel('spread',this)">
✧ Расклад
</button>

<button onclick="showPanel('week',this)">
📅 Совет на неделю
</button>

</div>

</section>

<section id="day" class="panel active center">

<button class="main-btn" onclick="generateDay()">
Получить карту дня ✨
</button>

<div class="cards" id="dayCards"></div>

<div class="result" id="dayResult"></div>

</section>

<section id="spread" class="panel center">

<textarea id="question"
placeholder="Напиши свой запрос..."></textarea>

<br><br>

<button class="main-btn" onclick="generateSpread()">
Открыть расклад ✨
</button>

<div class="cards" id="spreadCards"></div>

<div class="result" id="spreadResult"></div>

</section>

<section id="week" class="panel center">

<div class="week-date" id="weekDate"></div>

<button class="main-btn" onclick="generateWeek()">
Получить совет недели ✨
</button>

<div class="cards" id="weekCards"></div>

<div class="result" id="weekResult"></div>

</section>

<div class="footer">
© Айгуль Галинская • Mystic Oracle
</div>

</div>

<script>

const tarotCards=[

{
name:"Солнце",
image:"cards/sun.jpg",
text:"Сейчас пространство постепенно выводит тебя из внутренней тяжести и напряжения. Эта карта показывает раскрытие, возвращение энергии, ясности и способности снова чувствовать вкус жизни. Очень многое сейчас зависит от того, насколько честно ты позволяешь себе быть собой и перестаёшь жить через страх оценки."
},

{
name:"Луна",
image:"cards/moon.jpg",
text:"Ты можешь находиться в периоде внутренней тревоги, эмоциональной путаницы или ощущения, будто жизнь снова идёт по кругу. Луна показывает скрытые страхи, тревожные сценарии и эмоциональную перегрузку. Сейчас важно не принимать решения из страха и не пытаться контролировать всё вокруг."
},

{
name:"Императрица",
image:"cards/empress.jpg",
text:"Карта про женственность, тело, ресурс и возвращение к себе. Душа устала жить только через напряжение и выживание. Сейчас очень важно научиться принимать, а не только отдавать."
},

{
name:"Башня",
image:"cards/tower.jpg",
text:"В твоей жизни может разрушаться старый сценарий или внутренняя конструкция, которая больше не может существовать по-старому. Это не наказание — это освобождение пространства для нового этапа."
},

{
name:"Верховная Жрица",
image:"cards/priestess.jpg",
text:"Ты уже чувствуешь ответы внутри себя, но пока ещё можешь сомневаться в собственной интуиции. Сейчас особенно важно научиться слышать себя и перестать игнорировать внутренние сигналы."
}

];

function createStars(){

const stars=document.getElementById('stars');

for(let i=0;i<120;i++){

const s=document.createElement('div');

s.classList.add('star');

s.style.left=Math.random()*100+'%';
s.style.top=Math.random()*100+'%';

s.style.animationDelay=Math.random()*5+'s';

stars.appendChild(s);

}

}

createStars();

function showPanel(id,btn){

document.querySelectorAll('.panel').forEach(p=>{
p.classList.remove('active');
});

document.querySelectorAll('.menu button').forEach(b=>{
b.classList.remove('active');
});

document.getElementById(id).classList.add('active');

btn.classList.add('active');

}

function randomCard(){

return tarotCards[Math.floor(Math.random()*tarotCards.length)];

}

function createCard(card){

return `

<div class="tarot-card">

<div class="card-inner">

<div class="card-front"
onclick="flipCard(this)">
<span>Нажми на карту ✨</span>
</div>

<div class="card-back">

<img src="${card.image}">

<h3>${card.name}</h3>

<p>${card.text}</p>

</div>

</div>

</div>

`;

}

function flipCard(el){

el.closest('.tarot-card').classList.add('flipped');

}

function buttons(){

return `

<div class="buttons">

<a class="btn-main"
href="https://t.me/m/ZM8rt97KOGNi"
target="_blank">
Записаться на полный расклад
</a>

<a class="btn-main"
href="https://aygulgalinskaya.github.io/oracul/"
target="_blank">
Узнать свой сценарий сейчас
</a>

<a class="btn-dark"
href="https://t.me/aigul_karma/1257"
target="_blank">
Как ты сливаешь энергию
</a>

<a class="btn-dark"
href="https://t.me/aigul_karma"
target="_blank">
Telegram
</a>

<a class="btn-dark"
href="https://max.ru/join/jv41Dc6yQ7gsYUAEx2B3aLTTnGmGHKGBSGX1i_kJFhM"
target="_blank">
MAX
</a>

<button class="btn-dark"
onclick="shareResult()">
Поделиться / сохранить
</button>

</div>

`;

}

function generateDay(){

const card=randomCard();

document.getElementById('dayCards').innerHTML=createCard(card);

document.getElementById('dayResult').style.display='block';

document.getElementById('dayResult').innerHTML=`

<h2>
Послание дня
</h2>

<p>
Сегодня пространство словно замедляет тебя не случайно.
Очень многое сейчас происходит внутри:
через эмоции,
ощущения,
усталость,
мысли
и внутренние реакции,
которые ты могла долго не замечать.
</p>

<p>
Иногда карта показывает только верхний слой того,
что происходит внутри.
Если чувствуешь,
что ситуация повторяется снова и снова —
важно смотреть глубже:
где именно запускается сценарий,
как он влияет на отношения,
деньги,
состояние
и почему жизнь снова идёт по кругу.
</p>

${buttons()}

`;

}

function generateSpread(){

let html='';

for(let i=0;i<3;i++){

html+=createCard(randomCard());

}

document.getElementById('spreadCards').innerHTML=html;

document.getElementById('spreadResult').style.display='block';

document.getElementById('spreadResult').innerHTML=`

<h2>
Главный смысл расклада
</h2>

<p>
Карты показывают:
сейчас в твоей жизни активен повторяющийся эмоциональный сценарий,
который влияет сразу на несколько сфер —
отношения,
самооценку,
внутреннее состояние,
реализацию
и уровень энергии.
</p>

<p>
Ты могла слишком долго жить через напряжение,
контроль,
страх ошибок
или попытку заслужить любовь и безопасность.
Но душа уже не хочет возвращаться в этот цикл.
</p>

<p>
В личной работе и полном раскладе
я помогаю увидеть:
где запускается сценарий,
почему он повторяется,
как влияет на отношения,
деньги,
состояние
и что поможет выйти из этого цикла.
</p>

${buttons()}

`;

}

function generateWeek(){

let html='';

for(let i=0;i<3;i++){

html+=createCard(randomCard());

}

document.getElementById('weekCards').innerHTML=html;

document.getElementById('weekResult').style.display='block';

document.getElementById('weekResult').innerHTML=`

<h2>
Главная энергия недели
</h2>

<p>
Эта неделя показывает период внутренней перестройки и переоценки.
Сейчас особенно важно:
не жить через тревогу,
не пытаться всё удерживать под контролем
и не возвращаться снова в старые эмоциональные сценарии.
</p>

<p>
Главное послание недели:
жизнь постепенно выводит тебя
в более честный контакт с собой.
И именно это станет началом новых изменений.
</p>

<p>
Если чувствуешь,
что хочешь понять свою ситуацию глубже —
приходи на полный расклад по твоему запросу
или расклад на месяц,
где мы посмотрим:
что тебя ждёт,
какие энергии влияют на ситуацию
и как лучше действовать именно сейчас.
</p>

${buttons()}

`;

}

function shareResult(){

if(navigator.share){

navigator.share({
title:'Mystic Oracle',
text:'Моё послание от Айгуль Галинской ✨',
url:window.location.href
});

}else{

alert('На компьютере можно просто скопировать ссылку ✨');

}

}

function getWeekDates(){

const now=new Date();

const day=now.getDay();

const monday=new Date(now);

monday.setDate(now.getDate()-(day===0?6:day-1));

const sunday=new Date(monday);

sunday.setDate(monday.getDate()+6);

const format=d=>`${d.getDate()}.${d.getMonth()+1}.${d.getFullYear()}`;

document.getElementById('weekDate').innerHTML=
`Совет на неделю • ${format(monday)} — ${format(sunday)}`;

}

getWeekDates();

</script>

</body>
</html>
